# Copy to .env.local and fill in.
# Robinhood Chain mainnet.
PONDER_CHAIN_ID=4663
PONDER_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Block of the PontoonLauncher deployment (start after any test activity so the site stays clean).
PONDER_START_BLOCK=

# Pons V2 launch factory. Empty = the live mainnet factory 0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e.
PONS_FACTORY_ADDRESS=

# Pontoon contracts
PONTOON_LAUNCHER_ADDRESS=
TOKEN_REGISTRY_ADDRESS=
BUYBACK_EXECUTOR_ADDRESS=
PLATFORM_TREASURY_ADDRESS=
CTO_MANAGER_ADDRESS=

# Optional. Without it Ponder uses an embedded PGlite database in .ponder/
DATABASE_URL=
# Required by `ponder start` (production). `ponder dev` does not need it.
DATABASE_SCHEMA=pontoon
