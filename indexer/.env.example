# Copy to .env.local and fill in.
# Robinhood Chain: set the official chain ID and RPC (see spec "Pertanyaan teknis lain").
PONDER_CHAIN_ID=31337
PONDER_RPC_URL=http://127.0.0.1:8545
PONDER_START_BLOCK=0

# Pons V2 factory (placeholder ABI until the real one is known)
PONS_FACTORY_ADDRESS=

# Pontoon contracts
PONTOON_LAUNCHER_ADDRESS=
TOKEN_REGISTRY_ADDRESS=
BUYBACK_EXECUTOR_ADDRESS=
PLATFORM_TREASURY_ADDRESS=
CTO_MANAGER_ADDRESS=

# Optional. Without it Ponder uses an embedded PGlite database in .ponder/
DATABASE_URL=
# Required by `ponder start` (production). `ponder dev` does not need it.
DATABASE_SCHEMA=pontoon
