# Copy to .env.local. `../indexer/scripts/local-demo.sh` writes a ready-made one for anvil.

# Leave empty to run on dummy data (contract writes disabled).
NEXT_PUBLIC_INDEXER_URL=

# Robinhood Chain (set the official values once confirmed)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# Optional: enables WalletConnect / mobile wallets in RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Pontoon contracts
NEXT_PUBLIC_LAUNCHER_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_BUYBACK_EXECUTOR_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_CTO_MANAGER_ADDRESS=

# Pons V2 (placeholder ABI until the real one is known)
NEXT_PUBLIC_PONS_FACTORY_ADDRESS=
NEXT_PUBLIC_PONS_ROUTER_ADDRESS=
NEXT_PUBLIC_V4_ADAPTER_ADDRESS=

# Quote pair assets (ETH needs no address)
NEXT_PUBLIC_QUOTE_USDG=
NEXT_PUBLIC_QUOTE_NVDA=
NEXT_PUBLIC_QUOTE_AAPL=
NEXT_PUBLIC_QUOTE_HOOD=
