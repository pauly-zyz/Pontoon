# Copy to .env.local. `../indexer/scripts/local-demo.sh` writes a ready-made one for anvil.

# Leave empty for pre-launch mode: real (empty) data, a "launching soon" notice, writes disabled.
NEXT_PUBLIC_INDEXER_URL=

# Local design work only: show sample tokens when no indexer is set. Never enable in production.
NEXT_PUBLIC_DEMO_DATA=

# Chain. Defaults to Robinhood Chain mainnet (4663, public RPC, Blockscout). For testnet use 46630
# and its RPC/explorer. Use a dedicated RPC provider in production; the public RPC is rate limited.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# Optional: enables WalletConnect / mobile wallets in RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Pontoon contracts
NEXT_PUBLIC_LAUNCHER_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_BUYBACK_EXECUTOR_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_CTO_MANAGER_ADDRESS=

# Pons V2 launch factory. Empty = the live mainnet factory.
NEXT_PUBLIC_PONS_FACTORY_ADDRESS=

# Market cap and volume are always shown in USD using a live ETH price (CoinGecko, Coinbase, Binance).
# Optional: set a fixed ETH/USD price instead, e.g. on testnets.
NEXT_PUBLIC_ETH_USD_PRICE=
